data_from_pyxtal

_symmetry_space_group_name_H-M 'P1'
_symmetry_Int_Tables_number                    1
_symmetry_cell_setting                 triclinic
_cell_length_a            2.687291
_cell_length_b            5.254102
_cell_length_c            3.897363
_cell_angle_alpha        96.263099
_cell_angle_beta         81.665765
_cell_angle_gamma        79.682999
_cell_volume             53.048572

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
C      C        1     0.916744    0.910987    0.876593 1
#END

